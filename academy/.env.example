# Postgres (Neon, Supabase, Vercel Postgres or your own)
DATABASE_URL="postgresql://user:pass@localhost:5432/academy"

# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=""

# Public URL of the site, no trailing slash
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe: create one Product with a one-time Price, paste the price id
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
# Set to 1 once Stripe Tax is switched on in the dashboard (EU VAT on digital goods)
STRIPE_TAX="0"

# Resend (sign-in links)
RESEND_API_KEY=""
EMAIL_FROM="Naked Chart School <hello@yourdomain.com>"

# Local testing only: unlocks every lesson without a purchase. Ignored in production.
DEV_UNLOCK_ALL="0"
